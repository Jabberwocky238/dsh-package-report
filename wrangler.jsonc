{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dsh-package-report",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-26",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api", "/api/*", "/README.md"]
	},
	"routes": [
		{ "pattern": "dsh-report.app238.com", "custom_domain": true }
	],
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
